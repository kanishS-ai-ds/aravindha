# ARAVINDHA Disaster Warning System - Environment Configuration

# Server Port
PORT=4000

# SMS Provider Selection: 'FAST2SMS' (India), 'TWILIO' (Global), 'MSG91', 'TEXTLOCAL', 'CUSTOM_WEBHOOK', 'MOCK'
# Note: You can also configure this directly in the Dashboard under "System Settings".
SMS_PROVIDER=FAST2SMS

# Option 1: Fast2SMS (India Quick SMS API - Recommended for Indian Numbers +91...)
# Get free API Key with credits at: https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option 2: Twilio (Global SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+18005550199

# Option 3: MSG91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_FLOW_ID=your_msg91_flow_id
MSG91_SENDER_ID=ARAVIN

# Option 4: Textlocal (India)
TEXTLOCAL_API_KEY=your_textlocal_api_key
TEXTLOCAL_SENDER=TXTLCL

# Option 5: Custom Webhook / Local GSM Modem Gateway
CUSTOM_WEBHOOK_URL=
CUSTOM_WEBHOOK_AUTH=
